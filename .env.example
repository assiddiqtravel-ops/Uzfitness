# ============================================================
# UzFit AI — environment sozlamalari namunasi
# Bu faylni nusxalab .env qiling:  cp .env.example .env
# Maxfiy qiymatlarni HECH QACHON git ga joylashtirmang.
# ============================================================

# --- Telegram ---
# @BotFather dan olingan bot tokeni (majburiy)
BOT_TOKEN=

# --- AI provayder ---
# "openai", "anthropic" yoki "none" (AI o'chirilgan holat)
AI_PROVIDER=none
# AI provayder API kaliti (tanlangan provayderga mos keladigani)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Model nomi. Masalan: gpt-4o-mini  yoki  claude-sonnet-5
AI_MODEL=gpt-4o-mini
# AI so'rovlari uchun timeout (soniya)
AI_TIMEOUT=30
# Bitta AI javobidagi maksimal tokenlar
AI_MAX_TOKENS=800

# --- Administratorlar ---
# Vergul bilan ajratilgan Telegram user ID lar. Masalan: 123456789,987654321
ADMIN_IDS=

# --- Database ---
# SQLite (default, lokal/VPS uchun). Async driver ishlatiladi.
DATABASE_URL=sqlite+aiosqlite:///data/uzfit.db
# Serverless (Vercel) uchun Postgres ishlating, masalan:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# --- Redis (ixtiyoriy) ---
# Serverless (Vercel) da FSM (ro'yxatdan o'tish) uchun kerak. Lokal/VPS/Render
# worker da SHART EMAS (default MemoryStorage). Masalan (Upstash):
# REDIS_URL=redis://default:password@host:6379
REDIS_URL=

# --- Vaqt zonasi ---
# Default foydalanuvchi vaqt zonasi (IANA nomi)
TIMEZONE=Asia/Tashkent

# --- Ishga tushirish rejimi ---
# "polling" yoki "webhook"
RUN_MODE=polling
# Webhook rejimi uchun (RUN_MODE=webhook bo'lsa majburiy):
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# Telegram webhook uchun maxfiy token (ixtiyoriy, xavfsizlik uchun tavsiya etiladi)
WEBHOOK_SECRET=

# --- Log ---
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
